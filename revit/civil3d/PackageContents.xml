  <Components Description="Civil 3D 2027">
    <RuntimeRequirements OS="Win64" Platform="Civil3D" SeriesMin="R26.0" SeriesMax="R26.9" />
    <ComponentEntry
      AppName="BecsaVisorC3D"
      Version="1.4.0"
      ModuleName="./Contents/BecsaVisorC3D.dll"
      AppDescription="Exportar al Visor BIM"
      LoadOnAutoCADStartup="True">
      <Commands GroupName="BECSATOOLS_C3D_VISOR">
        <Command Global="BECSA_EXPORTARVISOR" Local="BECSA_EXPORTARVISOR" />
        <Command Global="BECSA_CINTA_VISOR" Local="BECSA_CINTA_VISOR" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
