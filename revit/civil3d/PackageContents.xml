<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
  SchemaVersion="1.0"
  AutodeskProduct="AutoCAD"
  ProductType="Application"
  Name="BECSATools Visor BIM C3D"
  Description="Exporta el dibujo de Civil 3D al Visor BIM (DAE + XLSX), federable con Revit"
  AppVersion="1.4.0"
